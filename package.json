{
  "name": "wishlist",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "start": "node scripts/serve.mjs",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "node tests/browser.mjs",
    "backup": "node scripts/backup.mjs",
    "restore:check": "node scripts/restore-check.mjs",
    "test:docker": "node tests/docker.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.0",
    "@simplewebauthn/browser": "^13.2.0",
    "@simplewebauthn/server": "^13.2.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-node": "^6.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@types/node": "^24.0.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.3.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.0",
    "vite": "^8.0.12"
  },
  "imports": {
    "#lib/*.svelte": "./src/lib/*.svelte",
    "#lib/*.css": "./src/lib/*.css",
    "#lib/*": "./src/lib/*.ts"
  }
}
